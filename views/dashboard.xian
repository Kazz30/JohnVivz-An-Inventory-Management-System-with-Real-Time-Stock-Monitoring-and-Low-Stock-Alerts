{{> head}}
<body class="app-body">
  <div class="app-shell">
    {{> sidebar section="dashboard"}}
    <main class="main-panel">
      {{> topbar}}
      <section class="page-content">
        {{#each success_msg}}<div class="notice notice-success">{{this}}</div>{{/each}}
        {{#each error_msg}}<div class="notice notice-error">{{this}}</div>{{/each}}
        <div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>{{dashboardHeading}}</h1><p class="muted">{{dashboardSubtitle}}</p></div>{{#if dashboardActionHref}}<a class="button button-primary" href="{{dashboardActionHref}}">{{dashboardActionLabel}}</a>{{/if}}</div>
        <div class="stats-grid">
          {{#each stats}}<article class="stat-card tone-{{tone}}"><span>{{label}}</span><strong>{{value}}</strong><small>Current database totals</small></article>{{/each}}
        </div>
        <div class="dashboard-grid">
          <section class="panel chart-panel"><div class="panel-heading"><div><h2>Stock by category</h2><p class="muted">Current on-hand quantity</p></div></div><div class="chart-wrap"><canvas id="category-chart" data-chart="{{categoryChart}}"></canvas></div></section>
          <section class="panel chart-panel"><div class="panel-heading"><div><h2>Stock movements</h2><p class="muted">Recorded quantity · last 30 days</p></div></div><div class="chart-wrap"><canvas id="movement-chart" data-chart="{{movementChart}}"></canvas></div></section>
        </div>
        <div class="dashboard-grid">
          <section class="panel"><div class="panel-heading"><div><h2>Recent stock movements</h2><p class="muted">Latest inventory activity</p></div><a href="/movements">View history →</a></div>
            <div class="table-wrap"><table><thead><tr><th>Product</th><th>Type</th><th>Quantity</th><th>Recorded by</th><th>Date</th></tr></thead><tbody>
              {{#each movements}}<tr><td>{{product}}</td><td><span class="status-pill">{{type}}</span></td><td>{{quantity}}</td><td>{{user}}</td><td>{{date}}</td></tr>{{else}}<tr><td colspan="5" class="empty-state">No stock movements have been recorded.</td></tr>{{/each}}
            </tbody></table></div>
          </section>
          <section class="panel"><div class="panel-heading"><div><h2>Unread notifications</h2><p class="muted">Low-stock messages for your account</p></div><a href="/notifications">View all →</a></div>
            <div class="notification-list">{{#each notifications}}<article class="notification-item"><span class="notification-dot"></span><div><p>{{message}}</p><small>{{date}}</small></div></article>{{else}}<p class="empty-state">You are all caught up.</p>{{/each}}</div>
          </section>
        </div>
      </section>
    </main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    document.querySelectorAll("canvas[data-chart]").forEach((canvas, index) => {
      const data = JSON.parse(canvas.getAttribute("data-chart") || "{}");
      new Chart(canvas, {
        type: index === 0 ? "doughnut" : "bar",
        data: { labels: data.labels, datasets: [{ data: data.values, backgroundColor: ["#0866D9", "#102957", "#4CC2FF", "#16A34A", "#F59E0B", "#7C5CE0"], borderWidth: 0, borderRadius: 8 }] },
        options: { maintainAspectRatio: false, plugins: { legend: { position: index === 0 ? "bottom" : "top", labels: { usePointStyle: true, boxWidth: 8, color: "#5b6b85" } } }, scales: index === 0 ? {} : { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: "#edf1f7" } } } }
      });
    });
  </script>
{{> footer}}
