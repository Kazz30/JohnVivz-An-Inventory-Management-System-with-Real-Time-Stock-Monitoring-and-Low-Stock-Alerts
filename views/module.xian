{{> head}}
<body class="app-body">
  <div class="app-shell">
    {{> sidebar}}
    <main class="main-panel">
      {{> topbar}}
      <section class="page-content">
        {{#each success_msg}}<div class="notice notice-success">{{this}}</div>{{/each}}
        {{#each error_msg}}<div class="notice notice-error">{{this}}</div>{{/each}}
        <div class="page-heading"><div><p class="eyebrow">JOHNVIVZ INVENTORY</p><h1>{{title}}</h1>{{#if subtitle}}<p class="muted">{{subtitle}}</p>{{/if}}</div><div class="heading-actions">{{#each actions}}<a class="button button-primary" href="{{href}}">{{label}}</a>{{/each}}{{#each postActions}}<form method="post" action="{{action}}" class="inline-action"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="button button-secondary" type="submit">{{label}}</button></form>{{/each}}{{#if printable}}<button class="button button-secondary" type="button" onclick="window.print()">Print report</button>{{/if}}{{#if bulkAction}}<form method="post" action="{{bulkAction}}"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="button button-secondary" type="submit">Mark all as read</button></form>{{/if}}</div></div>
        {{#if details}}<section class="panel detail-grid">{{#each details}}<div><span class="muted">{{label}}</span><strong>{{value}}</strong></div>{{/each}}</section>{{/if}}
        {{#each summaryLines}}<p class="summary-line">{{#if href}}<a class="button button-secondary" href="{{href}}">{{label}}</a>{{else}}{{label}}{{#if value}}: {{value}}{{/if}}{{/if}}</p>{{/each}}
        {{#if statusFormAction}}
          {{#if canManage}}<form class="status-form" method="post" action="{{statusFormAction}}"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label for="order-status">Order status</label><select id="order-status" name="status">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button class="button button-secondary" type="submit">Update status</button></form>{{/if}}
        {{/if}}
        <div class="module-layout {{#if showForm}}with-form{{/if}}{{#unless showTable}} form-only{{/unless}}">
          {{#if showTable}}
          <section class="panel table-panel">
            {{#if filters}}<form method="get" class="filter-form">{{#each filters}}<label>{{label}}{{#if (isSelect type)}}<select name="{{name}}">{{#each options}}<option value="{{value}}" {{#if (isActive value ../value)}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{else}}<input type="{{type}}" name="{{name}}" value="{{value}}" placeholder="{{label}}">{{/if}}</label>{{/each}}<button class="button button-secondary" type="submit">Apply filters</button><a class="clear-link" href="/{{section}}">Clear</a></form>{{/if}}
            <div class="table-wrap"><table><thead><tr>{{#each columns}}<th>{{this}}</th>{{/each}}{{#if showActions}}<th>Actions</th>{{/if}}</tr></thead><tbody>
              {{#each rows}}
                <tr>{{#each cells}}<td>{{this}}</td>{{/each}}
                  {{#if @root.showActions}}<td class="actions-cell">
                    {{#if href}}<a class="table-action" href="{{href}}">View</a>{{/if}}
                    {{#if (isAdmin @root.currentUser.Role.name)}}
                      {{#if (isActive @root.section 'products')}}<a class="table-action" href="/products/{{id}}/edit">Edit</a>{{#if canArchive}}<form method="post" action="/products/{{id}}/archive" class="inline-action"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="table-action danger-link" type="submit" data-confirm="Archive this product?">Archive</button></form>{{/if}}{{/if}}
                      {{#if (isActive @root.section 'categories')}}<a class="table-action" href="/categories/{{id}}/edit">Edit</a>{{#if canDelete}}<form method="post" action="/categories/{{id}}/delete" class="inline-action"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="table-action danger-link" type="submit" data-confirm="Delete this category?">Delete</button></form>{{/if}}{{/if}}
                      {{#if (isActive @root.section 'suppliers')}}<a class="table-action" href="/suppliers/{{id}}/edit">Edit</a><form method="post" action="/suppliers/{{id}}/toggle" class="inline-action"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="table-action" type="submit">Toggle status</button></form>{{/if}}
                      {{#if (isActive @root.section 'users')}}{{#if action}}<form method="post" action="/users/{{id}}/toggle" class="inline-action"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="table-action" type="submit">{{#if toggleLabel}}{{toggleLabel}}{{else}}{{#if (isActive (lookup cells 3) 'Active')}}Deactivate{{else}}Activate{{/if}}{{/if}}</button></form>{{/if}}{{/if}}
                    {{/if}}
                    {{#if receiveAction}}<form method="get" action="{{receiveAction}}" class="inline-action"><button class="table-action" type="submit">Receive</button></form>{{/if}}
                    {{#if (isActive @root.section 'notifications')}}{{#unless (isRead (lookup cells 3))}}<form method="post" action="/notifications/{{id}}/read" class="inline-action"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="table-action" type="submit">Mark read</button></form>{{/unless}}{{/if}}
                  </td>{{/if}}
                </tr>
              {{else}}<tr><td class="empty-state" colspan="{{tableColumnCount columns showActions}}">{{emptyText}}</td></tr>{{/each}}
            </tbody></table></div>
            {{#if summary}}<p class="muted table-summary">{{summary}}</p>{{/if}}
          </section>
          {{/if}}
          {{#if showForm}}<section class="panel form-panel"><div class="panel-heading"><div><h2>{{formTitle}}</h2><p class="muted">Fields marked with * are required.</p></div></div>
            <form method="post" action="{{formAction}}" class="stack-form"{{#if skuPreviewUrl}} data-sku-preview="{{skuPreviewUrl}}"{{/if}}><input type="hidden" name="_csrf" value="{{csrfToken}}">
              {{#each fields}}
                {{#if (isActive type 'hidden')}}<input type="hidden" name="{{name}}" value="{{value}}">
                {{else}}<label>{{label}}{{#if required}} <span class="required">*</span>{{/if}}
                  {{#if (isActive type 'textarea')}}<textarea name="{{name}}" rows="3" {{#if required}}required{{/if}}>{{value}}</textarea>
                  {{else if (isActive type 'select')}}<select name="{{name}}" {{#if required}}required{{/if}}>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                  {{else}}<input type="{{type}}" name="{{name}}" value="{{value}}" {{#if required}}required{{/if}} {{#if readonly}}readonly aria-readonly="true"{{/if}} {{#if placeholder}}placeholder="{{placeholder}}"{{/if}} {{#if (isActive type 'number')}}min="0" step="any"{{/if}}>{{/if}}
                </label>{{/if}}
              {{/each}}
              <button class="button button-primary full-width" type="submit">Save</button>
            </form>
          </section>{{/if}}
        </div>
      </section>
    </main>
  </div>
  <script>
    // Product registration: show the server-generated SKU and refresh it when the category or name changes.
    (() => {
      const form = document.querySelector("form[data-sku-preview]");
      if (!form) return;
      const sku = form.elements.sku, category = form.elements.CategoryId, name = form.elements.name;
      if (!sku || !category || !name) return;
      let timer, latest = 0;
      const refresh = () => {
        const ticket = ++latest;
        const query = new URLSearchParams({ categoryId: category.value, name: name.value });
        fetch(form.dataset.skuPreview + "?" + query, { credentials: "same-origin", headers: { Accept: "application/json" } })
          .then(response => response.ok ? response.json() : null)
          .then(data => { if (data && data.sku && ticket === latest) sku.value = data.sku; })
          .catch(() => {});
      };
      category.addEventListener("change", refresh);
      name.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(refresh, 300); });
      refresh();
    })();
  </script>
{{> footer}}
