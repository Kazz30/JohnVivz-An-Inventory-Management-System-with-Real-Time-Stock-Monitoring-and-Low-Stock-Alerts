# Copy to .env and fill in. .env holds secrets: never commit or share it.
# Real environment variables override values in this file.

# --- Database / session (existing) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=JohnVivz_Invntry_System
DB_USER=root
DB_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-secret

# --- Inventory integration API ---
# Callers use per-system tokens stored (hashed) in the database, not .env:
#   npm run token -- create crm "CRM production"
#   npm run token -- create accounting "JVzPay production"
#   npm run token -- list | npm run token -- revoke <id>
# INVENTORY_INTEGRATION_TOKEN is no longer used.

# --- HR employee sync ---
HR_API_URL=http://localhost:3001
# Inventory's API key issued by HR.
HR_API_TOKEN=jvhr_inventory_cY7Jsa5fbIy7mep1OMjHuVeeH9iRgo6-IooP7iND9zU
# HR department_code of the Inventory department.
INVENTORY_DEPARTMENT_CODE=INVENTORY
# Optional. Default 300000 (5 minutes).
# HR_SYNC_INTERVAL_MS=300000

# --- ESS sign-in through JVzPay ---
JVZPAY_API_URL=http://localhost:3002
# Token created for Inventory by the Accounting team.
JVZPAY_API_TOKEN=jvz_aVp7d6t9O8izfs8ZfWSoJmMzb-BnfM2sXHNVzG_-naw
# local = today's local passwords (default). live = ESS passwords via JVzPay.
ESS_LOGIN_MODE=local
# Optional. The one local manager that keeps a local password in live mode.
# Default: the oldest local (non-HR) manager account.
# EMERGENCY_ADMIN_EMAIL=
# JVzPay employment_status values allowed to sign in (comma separated).
ESS_ALLOWED_STATUSES=Active,On Leave

# --- Role from HR position ---
# Ordered "text-in-title=role" rules; first match wins; no match = staff.
POSITION_ROLE_MAP=Inventory Manager=manager,Inventory Supervisor=supervisor,Inventory Staff=staff

# Optional. Timeout for HR/JVzPay calls in ms. Default 8000.
# EXTERNAL_REQUEST_TIMEOUT_MS=8000
